# Dead Reckoning System - .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data — keep structure, ignore large files
data/raw/*.csv
data/raw/*.bin
data/raw/*.msgpack
data/processed/*.npy
data/processed/*.pkl
!data/raw/.gitkeep
!data/processed/.gitkeep

# ML models & checkpoints
*.pt
*.pth
*.onnx
*.tflite
checkpoints/

# Logs
*.log
logs/

# Secrets
.env
*.key
*.pem

# Coverage & test artifacts
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
data/raw/io-vnbd/
data/processed/*.csv
data/processed/*.bin
